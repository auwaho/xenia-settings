root = true

[*.{cs,csproj,sln,resx,config,settings,ps1}]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true

[*.{md,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

[*.cs]
trim_trailing_whitespace = true
